---
layout: default
---

{% comment %} ===== Publications — "What I Do" 아코디언 =====
  Design adapted from "Agency Layout" by Freask'O (MIT)
  https://codepen.io/fchaussin/pen/PwbPEVV
{% endcomment %}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" />

<style>
  #navbar, footer, .post .post-header { display: none !important; }
  html, body { margin: 0 !important; padding: 0 !important; }
  .container.mt-5, .container[role="main"] { margin: 0 !important; padding: 0 !important; max-width: 100% !important; }

  .pub {
    --c-bg: oklch(96% 0.005 90);
    --c-fg: oklch(15% 0 0);
    --c-fg-soft: oklch(15% 0 0 / 0.6);
    --c-line: oklch(15% 0 0);
    --c-accent: oklch(88% 0.22 125);
    --ff-display: "Archivo Black", ui-sans-serif, system-ui, sans-serif;
    --ff-body: "Archivo", ui-sans-serif, system-ui, sans-serif;
    --ff-mono: "JetBrains Mono", ui-monospace, monospace;
    --s-2: 0.5rem; --s-3: 0.75rem; --s-4: 1rem; --s-5: 1.5rem; --s-6: 2rem; --s-7: 3rem;
    --bw: 1px; --bw-thick: 0.125rem;
    --pad-x: var(--s-4);
    color: var(--c-fg);
    background: var(--c-bg);
    font-family: var(--ff-body);
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
  }
  @media (min-width: 48rem) { .pub { --pad-x: var(--s-5); } }
  @media (min-width: 80rem) { .pub { --pad-x: 2rem; } }
  .pub *, .pub *::before, .pub *::after { box-sizing: border-box; }
  .pub a { color: inherit; text-decoration: none; }
  .pub ::selection { background: var(--c-accent); color: var(--c-fg); }

  .pub-topbar {
    position: fixed; inset: 0 0 auto 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between; gap: var(--s-4);
    padding: var(--s-4) var(--pad-x); color: #fff; mix-blend-mode: difference; pointer-events: none;
  }
  .pub-topbar > * { pointer-events: auto; }
  .pub-topbar__brand { font-family: var(--ff-display); font-size: 1.125rem; letter-spacing: -0.02em; text-transform: uppercase; }
  .pub-topbar__brand::after { content: " ●"; color: var(--c-accent); }
  .pub-topbar__nav { display: none; gap: var(--s-5); }
  @media (min-width: 48rem) { .pub-topbar__nav { display: flex; } }
  .pub-topbar__nav a { font-family: var(--ff-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .pub-topbar__nav a::before { content: "↳ "; opacity: 0.5; }
  .pub-topbar__nav a:hover { color: var(--c-accent); }

  .pub .section-head {
    display: grid; grid-template-columns: 1fr; gap: var(--s-3);
    padding: calc(var(--s-7) + 2.5rem) var(--pad-x) var(--s-5);
    border-bottom: var(--bw) solid var(--c-line);
  }
  @media (min-width: 48rem) { .pub .section-head { grid-template-columns: auto 1fr auto; align-items: end; } }
  .pub .section-head__num, .pub .section-head__count {
    font-family: var(--ff-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.5;
  }
  .pub .section-head__title {
    font-family: var(--ff-display); font-size: clamp(2rem, 6vw, 4.5rem); line-height: 0.9;
    letter-spacing: -0.03em; text-transform: uppercase; margin: 0;
  }

  /* 아코디언 */
  .services__list { list-style: none; margin: 0; padding: 0; }
  .services__item { border-bottom: var(--bw) solid var(--c-line); transition: background 200ms, color 200ms; }
  .services__item:last-child { border-bottom: 0; }
  .services__item[data-open="true"] { background: var(--c-fg); color: var(--c-bg); }
  .services__item[data-open="true"] .services__num { color: var(--c-accent); }
  .services__item[data-open="true"] .services__arrow { transform: rotate(45deg); }

  .services__trigger {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: var(--s-4);
    width: 100%; padding: var(--s-5) var(--pad-x); text-align: left;
    font: inherit; color: inherit; background: transparent; border: 0; cursor: pointer;
  }
  .services__item:not([data-open="true"]) .services__trigger:hover { background: var(--c-fg); color: var(--c-bg); }
  .services__item:not([data-open="true"]) .services__trigger:hover .services__num { color: var(--c-accent); }

  .services__num { font-family: var(--ff-mono); font-size: clamp(1rem, 2vw, 1.5rem); font-weight: 500; transition: color 200ms; }
  .services__name { font-family: var(--ff-display); font-size: clamp(1.75rem, 7vw, 5rem); line-height: 0.9; letter-spacing: -0.04em; text-transform: uppercase; }
  .services__arrow { font-family: var(--ff-mono); font-size: clamp(1.25rem, 2.5vw, 2rem); display: inline-block; transition: transform 300ms cubic-bezier(0.2,0.8,0.2,1); line-height: 1; }

  .services__panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 400ms cubic-bezier(0.2,0.8,0.2,1); }
  .services__item[data-open="true"] .services__panel { grid-template-rows: 1fr; }
  .services__panel-inner { overflow: hidden; min-height: 0; }
  .services__panel-content { padding: var(--s-4) var(--pad-x) var(--s-6); border-top: var(--bw) solid var(--c-bg); display: grid; gap: var(--s-5); }
  @media (min-width: 64rem) { .services__panel-content { grid-template-columns: 1.4fr 1fr auto; align-items: end; gap: var(--s-6); } }

  .services__desc { font-family: var(--ff-body); font-size: clamp(0.9375rem, 1.4vw, 1.125rem); line-height: 1.45; margin: 0; max-width: 60ch; }
  .services__sublist { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: var(--s-2) var(--s-4); }
  .services__sublist li { font-family: var(--ff-mono); font-size: 0.75rem; letter-spacing: 0.03em; line-height: 1.4; }
  .services__sublist li::before { content: "↳ "; opacity: 0.5; }
  .services__cta {
    display: inline-flex; align-items: center; gap: var(--s-2);
    font-family: var(--ff-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em;
    padding: var(--s-3) var(--s-4); border: var(--bw-thick) solid var(--c-bg); color: var(--c-bg);
    align-self: end; justify-self: start; white-space: nowrap;
    transition: background 150ms, color 150ms, border-color 150ms;
  }
  .services__cta:hover { background: var(--c-accent); color: var(--c-fg); border-color: var(--c-accent); }

  .pub-foot {
    padding: var(--s-7) var(--pad-x);
    font-family: var(--ff-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: var(--s-4); opacity: 0.7;
    border-top: var(--bw) solid var(--c-line);
  }
</style>

<div class="pub">
  <header class="pub-topbar">
    <a class="pub-topbar__brand" href="{{ '/' | relative_url }}">{{ site.first_name }}.ai</a>
    <nav class="pub-topbar__nav" aria-label="Primary">
      <a href="{{ '/about/' | relative_url }}">About</a>
      <a href="{{ '/blog/' | relative_url }}">Blog</a>
      <a href="{{ '/playground/' | relative_url }}">Playground</a>
      <a href="{{ '/' | relative_url }}">Home</a>
    </nav>
    <div></div>
  </header>

  <section class="services" id="services">
    <div class="section-head">
      <div class="section-head__num">[03] / Publications</div>
      <h2 class="section-head__title">Publications</h2>
      <div class="section-head__count">04 Categories</div>
    </div>
    <ul class="services__list">

      <li class="services__item" data-open="false">
        <button class="services__trigger" type="button" aria-expanded="false" aria-controls="pub-panel-1">
          <span class="services__num">01</span>
          <span class="services__name">Papers</span>
          <span class="services__arrow" aria-hidden="true">+</span>
        </button>
        <div class="services__panel" id="pub-panel-1">
          <div class="services__panel-inner"><div class="services__panel-content">
            <p class="services__desc">Peer-reviewed papers and conference proceedings. Replace these with your real publications — title, venue, and year.</p>
            <ul class="services__sublist">
              <li>Paper title one — Venue, 2026</li>
              <li>Paper title two — Venue, 2025</li>
              <li>Paper title three — Venue, 2024</li>
            </ul>
            <a class="services__cta" href="#">View all →</a>
          </div></div>
        </div>
      </li>

      <li class="services__item" data-open="false">
        <button class="services__trigger" type="button" aria-expanded="false" aria-controls="pub-panel-2">
          <span class="services__num">02</span>
          <span class="services__name">Preprints</span>
          <span class="services__arrow" aria-hidden="true">+</span>
        </button>
        <div class="services__panel" id="pub-panel-2">
          <div class="services__panel-inner"><div class="services__panel-content">
            <p class="services__desc">Work in progress and arXiv preprints on AI, video generation, and world models.</p>
            <ul class="services__sublist">
              <li>Preprint title — arXiv, 2026</li>
              <li>Preprint title — arXiv, 2025</li>
            </ul>
            <a class="services__cta" href="#">View all →</a>
          </div></div>
        </div>
      </li>

      <li class="services__item" data-open="false">
        <button class="services__trigger" type="button" aria-expanded="false" aria-controls="pub-panel-3">
          <span class="services__num">03</span>
          <span class="services__name">Talks</span>
          <span class="services__arrow" aria-hidden="true">+</span>
        </button>
        <div class="services__panel" id="pub-panel-3">
          <div class="services__panel-inner"><div class="services__panel-content">
            <p class="services__desc">Invited talks, seminars, and presentations.</p>
            <ul class="services__sublist">
              <li>Talk title — Event, 2026</li>
              <li>Talk title — Event, 2025</li>
            </ul>
            <a class="services__cta" href="#">View all →</a>
          </div></div>
        </div>
      </li>

      <li class="services__item" data-open="false">
        <button class="services__trigger" type="button" aria-expanded="false" aria-controls="pub-panel-4">
          <span class="services__num">04</span>
          <span class="services__name">Writing</span>
          <span class="services__arrow" aria-hidden="true">+</span>
        </button>
        <div class="services__panel" id="pub-panel-4">
          <div class="services__panel-inner"><div class="services__panel-content">
            <p class="services__desc">Blog posts, notes, and long-form writing.</p>
            <ul class="services__sublist">
              <li>Post title — 2026</li>
              <li>Post title — 2025</li>
            </ul>
            <a class="services__cta" href="{{ '/blog/' | relative_url }}">Read the blog →</a>
          </div></div>
        </div>
      </li>

    </ul>
  </section>

  <footer class="pub-foot">
    <span>{{ site.first_name }} {{ site.last_name }} — Publications</span>
    <span>From Korea with love</span>
  </footer>
</div>

{% raw %}
<script>
  (function () {
    const items = document.querySelectorAll(".pub .services__item");
    items.forEach((item) => {
      const trigger = item.querySelector(".services__trigger");
      const arrow = item.querySelector(".services__arrow");
      trigger.addEventListener("click", () => {
        const willOpen = item.dataset.open !== "true";
        items.forEach((other) => {
          if (other !== item) {
            other.dataset.open = "false";
            other.querySelector(".services__trigger").setAttribute("aria-expanded", "false");
            other.querySelector(".services__arrow").textContent = "+";
          }
        });
        item.dataset.open = String(willOpen);
        trigger.setAttribute("aria-expanded", String(willOpen));
        arrow.textContent = willOpen ? "−" : "+";
      });
    });
  })();
</script>
{% endraw %}
