---
layout: default
---
{% include minimal-styles.liquid %}

<div class="minimal-home">
  {% include minimal-header.liquid %}

  <section class="home-intro" id="about" aria-label="About">
    <p>{{ page.folio.left | default: 'An independent developer based in Seoul, South Korea.' }}</p>
    <p>{{ page.folio.right | default: 'Passionate about creating clean, reliable, and elegant digital experiences.' }}</p>
    <p class="home-caption">{{ page.folio.caption }}</p>
  </section>

  <section class="home-section" id="publications" aria-labelledby="publications-title">
    <div class="home-section-heading">
      <h2 id="publications-title"><span>03</span> Publications</h2>
      <span>{{ site.data.publications.size }} papers</span>
    </div>
    <ul class="pubs-list">
      {% for pub in site.data.publications %}
        <li class="pub-item{% if pub.preview or pub.abbr or pub.category or pub.show_placeholders %} pub-item--with-preview{% endif %}">
          {% if pub.preview or pub.abbr or pub.category or pub.show_placeholders %}
            <div class="pub-preview">
              {% assign category = pub.category | default: pub.abbr %}
              {% if category -%}
                <span class="pub-badge">{{ category | escape }}</span>
              {%- endif %}
              {% if pub.preview %}
                {% if pub.preview_source -%}
                  <a href="{{ pub.preview_source }}" target="_blank" rel="noopener noreferrer" aria-label="View paper figure">
                {%- endif %}
                <img src="{{ pub.preview | relative_url }}" alt="{{ pub.title | escape }}" loading="lazy">
                {% if pub.preview_source %}</a>{% endif %}
              {% elsif pub.show_placeholders %}
                <div class="pub-image-placeholder"><span>Preview image</span><span>준비 중</span></div>
              {% endif %}
            </div>
          {% endif %}
          <div class="pub-content">
            {% if pub.venue or pub.year %}
              <div class="pub-venue">
                {{ pub.venue | escape -}}
                {%- if pub.year -%}
                  {%- if pub.venue %} · {% endif -%}
                  {{- pub.year -}}
                {%- endif %}
              </div>
            {% endif %}
            <h3 class="pub-title">{{ pub.title | escape }}</h3>
            {% if pub.author_list %}
              <div class="pub-authors">
                {%- for author in pub.author_list -%}
                  {%- unless forloop.first -%}{{ ', ' }}{%- endunless -%}
                  {%- if author.url -%}<a href="{{ author.url }}">{%- endif -%}
                  {%- if author.self -%}<strong>{%- endif -%}
                  {{- author.name | strip | escape -}}
                  {%- if author.self -%}</strong>{%- endif -%}
                  {%- if author.url -%}</a>{%- endif -%}
                {%- endfor -%}
              </div>
            {% elsif pub.authors and pub.authors != '' %}
              <div class="pub-authors">{{ pub.authors | escape }}</div>
            {% elsif pub.show_placeholders %}
              <div class="pub-authors pub-placeholder">저자 정보 준비 중</div>
            {% endif %}
            {% if pub.note %}
              <div class="pub-note">{{ pub.note | escape }}</div>
            {% endif %}
            <div class="pub-actions">
              {% if pub.abstract and pub.abstract != '' %}
                <button class="pub-btn" type="button" aria-expanded="false" aria-controls="abstract-{{ forloop.index }}">Abs</button>
              {% endif %}
              {% assign resource_keys = 'pdf,arxiv,doi,html,supp,video,blog,code,poster,slides,website,dataset,demo' | split: ',' %}
              {% assign resource_labels = 'PDF,arXiv,DOI,HTML,Supp,Video,Blog,Code,Poster,Slides,Website,Dataset,Demo' | split: ',' %}
              {% for key in resource_keys %}
                {% assign resource_url = pub[key] %}
                {% if resource_url and resource_url != '' and resource_url != '#' %}
                  <a class="pub-btn" href="{{ resource_url | relative_url }}" target="_blank" rel="noopener noreferrer">
                    {{- resource_labels[forloop.index0] -}}
                  </a>
                {% elsif pub.show_placeholders %}
                  <button class="pub-btn" type="button" disabled title="{{ resource_labels[forloop.index0] }} 준비 중">
                    {{ resource_labels[forloop.index0] }}
                  </button>
                {% endif %}
              {% endfor %}
              {% for resource in pub.links %}
                {% if resource.url and resource.url != '' and resource.url != '#' %}
                  <a class="pub-btn" href="{{ resource.url | relative_url }}" target="_blank" rel="noopener noreferrer">
                    {{- resource.label | escape -}}
                  </a>
                {% endif %}
              {% endfor %}
              {% if pub.bibtex and pub.bibtex != '' %}
                <button class="pub-btn" type="button" aria-expanded="false" aria-controls="bibtex-{{ forloop.index }}">Bib</button>
              {% elsif pub.show_placeholders %}
                <button class="pub-btn" type="button" disabled title="인용 정보 준비 중">Bib</button>
              {% endif %}
            </div>
            {% if pub.abstract and pub.abstract != '' %}
              <div class="pub-panel" id="abstract-{{ forloop.index }}" hidden>
                <p>{{ pub.abstract | escape }}</p>
              </div>
            {% endif %}
            {% if pub.bibtex and pub.bibtex != '' %}
              <div class="pub-panel" id="bibtex-{{ forloop.index }}" hidden>
                <pre><code>{{ pub.bibtex | escape }}</code></pre>
              </div>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
  </section>

  <section class="home-section" id="playground" aria-labelledby="playground-title">
    <div class="home-section-heading">
      <h2 id="playground-title"><span>04</span> Playground</h2>
      <span>{{ site.data.playground.size }} items</span>
    </div>
    <div class="mosaic" id="mosaic" role="list"></div>
  </section>

  {% include minimal-footer.liquid %}
</div>

<div class="pg-detail" id="pg-detail" data-open="false" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="pg-detail__content">
    <div class="pg-detail__bar">
      <span id="pg-detail-crumb">№000</span>
      <button class="pg-detail__close" id="pg-detail-close" type="button">Close ✕</button>
    </div>
    <img class="pg-detail__img" id="pg-detail-img" src="" alt="">
    <div class="pg-detail__body">
      <h2 class="pg-detail__title" id="pg-detail-title"></h2>
      <div class="pg-detail__meta"><span id="pg-detail-client"></span><span id="pg-detail-year"></span><span id="pg-detail-role"></span></div>
      <p class="pg-detail__brief" id="pg-detail-brief"></p>
    </div>
  </div>
</div>

<script id="playground-data" type="application/json">
  {{ site.data.playground | default: empty | jsonify }}
</script>
{% raw %}
<script>
  (function () {
    /* ---------- Playground 모자이크 ---------- */
    const dataNode = document.getElementById("playground-data");
    let data = [];
    let lastTile = null;
    try {
      data = JSON.parse(dataNode ? dataNode.textContent : "[]");
    } catch (error) {
      console.warn("[folio] Playground 데이터를 읽지 못했습니다.", error);
    }

    const mosaic = document.getElementById("mosaic");
    const count = document.getElementById("pg-count");
    if (mosaic) {
      count && (count.textContent = data.length + (data.length === 1 ? " Item" : " Items"));
      const tiles = [];
      data.forEach((p, i) => {
        p.num = String(i + 1).padStart(3, "0");
        const a = document.createElement("a");
        a.className = "tile";
        a.href = "#";
        a.setAttribute("aria-haspopup", "dialog");
        a.setAttribute("role", "listitem");

        const image = document.createElement("img");
        image.src = p.thumbnail || p.image;
        image.alt = p.title || "Playground item";
        image.loading = i < 12 ? "eager" : "lazy";
        image.decoding = "async";

        const label = document.createElement("div");
        label.className = "tile__label";
        const number = document.createElement("span");
        number.textContent = "[" + p.num + "]";
        const year = document.createElement("span");
        year.textContent = p.year || "";
        label.append(number, year);
        a.append(image, label);

        a.addEventListener("click", (e) => { e.preventDefault(); openDetail(i); });
        mosaic.appendChild(a);
        tiles.push(a);
      });

      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduce) {
        tiles.forEach((t) => (t.dataset.visible = "true"));
      } else {
        let waveStart = performance.now(), waveCount = 0;
        const io = new IntersectionObserver((entries) => {
          const now = performance.now();
          if (now - waveStart > 400) { waveStart = now; waveCount = 0; }
          entries.forEach((en) => {
            if (en.isIntersecting) {
              en.target.style.setProperty("--reveal-delay", Math.min(waveCount * 35, 600) + "ms");
              en.target.dataset.visible = "true";
              waveCount++;
              io.unobserve(en.target);
            }
          });
        }, { rootMargin: "0px 0px -10% 0px", threshold: 0.05 });
        tiles.forEach((t) => io.observe(t));
      }
    }

    /* ---------- 상세 모달 ---------- */
    const detail = document.getElementById("pg-detail");
    const dImg = document.getElementById("pg-detail-img");
    const dTitle = document.getElementById("pg-detail-title");
    const dCrumb = document.getElementById("pg-detail-crumb");
    const dClient = document.getElementById("pg-detail-client");
    const dYear = document.getElementById("pg-detail-year");
    const dRole = document.getElementById("pg-detail-role");
    const dBrief = document.getElementById("pg-detail-brief");
    const dClose = document.getElementById("pg-detail-close");

    function openDetail(i) {
      const p = data[i];
      if (!p || !detail) return;
      lastTile = document.activeElement;
      dImg.src = p.image || p.thumbnail; dImg.alt = p.title || "Playground item";
      dTitle.textContent = p.title || "";
      dCrumb.textContent = "№" + p.num;
      dClient.textContent = p.client || "";
      dYear.textContent = p.year || "";
      dRole.textContent = p.role || "";
      dBrief.textContent = p.brief || "";
      detail.dataset.open = "true";
      detail.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      detail.scrollTop = 0;
      dClose.focus();
    }
    function closeDetail() {
      if (!detail) return;
      detail.dataset.open = "false";
      detail.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      if (lastTile) lastTile.focus();
    }
    detail.addEventListener("keydown", (e) => {
      if (e.key === "Tab") { e.preventDefault(); dClose.focus(); }
    });
    dClose && dClose.addEventListener("click", closeDetail);
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && detail && detail.dataset.open === "true") closeDetail(); });

    /* Inline abstract and citation panels for each publication. */
    document.querySelectorAll('#publications button[aria-controls]').forEach((button) => {
      button.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') !== 'true';
        button.setAttribute('aria-expanded', String(open));
        document.getElementById(button.getAttribute('aria-controls')).hidden = !open;
      });
    });
  })();
</script>
{% endraw %}
