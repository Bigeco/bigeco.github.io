{% comment %} ===== 낮/밤 토글 동작 (al-folio의 setThemeSetting 재사용) ===== {% endcomment %}
{% raw %}
<script>
  (function () {
    var btn = document.getElementById("folio-theme-toggle");
    if (!btn) return;

    function currentTheme() {
      return document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
    }

    btn.addEventListener("click", function () {
      var next = currentTheme() === "dark" ? "light" : "dark";

      // al-folio 전역 함수가 있으면 그대로 사용 → 다른 페이지와 완전 동기화
      if (typeof setThemeSetting === "function") {
        setThemeSetting(next);
      } else {
        // 폴백: 직접 적용
        try { localStorage.setItem("theme", next); } catch (e) {}
        document.documentElement.setAttribute("data-theme-setting", next);
        document.documentElement.setAttribute("data-theme", next);
      }

      // Liquid Glass 효과에 테마 변경을 알림(다크=효과 제거 / 라이트=새 색으로 재생성)
      window.dispatchEvent(new Event("folio:themechange"));
    });

    // 유리 on/off 버튼 → 모듈로 이벤트 전달
    var gbtn = document.getElementById("folio-glass-toggle");
    if (gbtn) {
      gbtn.addEventListener("click", function () {
        window.dispatchEvent(new Event("folio:glasstoggle"));
      });
    }

    // 고정 헤더: 아래로 스크롤하면 숨기고, 위로 스크롤하면 표시 (Google Labs 스타일)
    var header = document.getElementById("folio-header");
    if (header) {
      var menuButton = header.querySelector(".folio-menu-toggle");
      var socialMenu = header.querySelector(".folio-socials");
      var menuPanel = header.querySelector(".folio-menu-panel");
      var socialOrigin = document.createComment("folio-socials-origin");
      if (socialMenu && socialMenu.parentNode) {
        socialMenu.parentNode.insertBefore(socialOrigin, socialMenu);
      }

      function syncSocialMenuPlacement() {
        if (!socialMenu) return;
        var home = document.querySelector(".folio-home");
        if (window.innerWidth < 1200 && home) {
          if (socialMenu.parentNode !== home) home.appendChild(socialMenu);
          positionMobileSocialMenu();
        } else if (socialOrigin.parentNode && socialMenu.parentNode !== socialOrigin.parentNode) {
          socialOrigin.parentNode.insertBefore(socialMenu, socialOrigin.nextSibling);
          socialMenu.style.removeProperty("top");
        }
      }

      function positionMobileSocialMenu() {
        if (!socialMenu || window.innerWidth >= 1200) return;
        var home = document.querySelector(".folio-home");
        var heroName = document.querySelector(".folio-hero .hero-name");
        var illustration = document.querySelector(".folio-foot .folio-illus");
        if (!home || !heroName || !illustration) return;

        var homeRect = home.getBoundingClientRect();
        var nameRect = heroName.getBoundingClientRect();
        var illustrationRect = illustration.getBoundingClientRect();
        var midpoint = (nameRect.bottom + illustrationRect.top) / 2 - homeRect.top;
        socialMenu.style.top = Math.round(midpoint) + "px";
      }

      function setMenuOpen(open) {
        if (open) {
          var scrollbarWidth = Math.max(0, window.innerWidth - document.documentElement.clientWidth);
          document.documentElement.style.setProperty("--folio-scrollbar-width", scrollbarWidth + "px");
        }
        header.dataset.menuOpen = String(open);
        if (open) header.dataset.hidden = "false";
        if (menuButton) menuButton.setAttribute("aria-expanded", String(open));
        if (menuPanel) menuPanel.setAttribute("aria-hidden", String(!open));
        document.documentElement.classList.toggle("folio-menu-open", open);
        if (!open) document.documentElement.style.removeProperty("--folio-scrollbar-width");
      }

      if (menuButton) {
        menuButton.addEventListener("click", function () {
          setMenuOpen(header.dataset.menuOpen !== "true");
        });
      }
      if (socialMenu) {
        socialMenu.addEventListener("click", function (event) {
          if (event.target.closest("a")) setMenuOpen(false);
        });
      }
      if (menuPanel) {
        menuPanel.addEventListener("click", function (event) {
          if (event.target.closest("a")) setMenuOpen(false);
        });
      }
      document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") setMenuOpen(false);
      });
      window.addEventListener("resize", function () {
        if (window.innerWidth >= 1200) {
          setMenuOpen(false);
        }
        syncSocialMenuPlacement();
      });
      syncSocialMenuPlacement();
      window.addEventListener("load", positionMobileSocialMenu);
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(positionMobileSocialMenu).catch(function () {});
      }

      var lastY = window.scrollY || 0;
      var ticking = false;
      function onHeaderScroll() {
        if (header.dataset.menuOpen === "true") {
          header.dataset.hidden = "false";
          ticking = false;
          return;
        }
        var y = window.scrollY || document.documentElement.scrollTop || 0;
        if (y < 80) {
          header.dataset.hidden = "false"; // 최상단 근처에서는 항상 표시
        } else if (y > lastY + 6) {
          header.dataset.hidden = "true";  // 아래로 스크롤 → 숨김
        } else if (y < lastY - 6) {
          header.dataset.hidden = "false"; // 위로 스크롤 → 표시
        }
        lastY = y;
        ticking = false;
      }
      window.addEventListener("scroll", function () {
        if (!ticking) { window.requestAnimationFrame(onHeaderScroll); ticking = true; }
      }, { passive: true });
    }
  })();
</script>
