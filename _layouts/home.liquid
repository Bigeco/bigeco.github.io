{% comment %} ===== Playground 모자이크 + 상세 모달 + Publications 아코디언 ===== {% endcomment %}
<script id="playground-data" type="application/json">
  {{ site.data.playground | default: empty | jsonify }}
</script>
{% raw %}
<script>
  (function () {
    /* ---------- Playground 모자이크 ---------- */
    const dataNode = document.getElementById("playground-data");
    let data = [];
    try {
      data = JSON.parse(dataNode ? dataNode.textContent : "[]");
    } catch (error) {
      console.warn("[folio] Playground 데이터를 읽지 못했습니다.", error);
    }

    const mosaic = document.getElementById("mosaic");
    const count = document.getElementById("pg-count");
    if (mosaic) {
      count && (count.textContent = data.length + (data.length === 1 ? " Item" : " Items"));
      const tiles = [];
      data.forEach((p, i) => {
        p.num = String(i + 1).padStart(3, "0");
        const a = document.createElement("a");
        a.className = "tile";
        a.href = "#";
        a.setAttribute("role", "listitem");

        const image = document.createElement("img");
        image.src = p.thumbnail || p.image;
        image.alt = p.title || "Playground item";
        image.loading = i < 12 ? "eager" : "lazy";
        image.decoding = "async";

        const label = document.createElement("div");
        label.className = "tile__label";
        const number = document.createElement("span");
        number.textContent = "[" + p.num + "]";
        const year = document.createElement("span");
        year.textContent = p.year || "";
        label.append(number, year);
        a.append(image, label);

        a.addEventListener("click", (e) => { e.preventDefault(); openDetail(i); });
        mosaic.appendChild(a);
        tiles.push(a);
      });

      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduce) {
        tiles.forEach((t) => (t.dataset.visible = "true"));
      } else {
        let waveStart = performance.now(), waveCount = 0;
        const io = new IntersectionObserver((entries) => {
          const now = performance.now();
          if (now - waveStart > 400) { waveStart = now; waveCount = 0; }
          entries.forEach((en) => {
            if (en.isIntersecting) {
              en.target.style.setProperty("--reveal-delay", Math.min(waveCount * 35, 600) + "ms");
              en.target.dataset.visible = "true";
              waveCount++;
              io.unobserve(en.target);
            }
          });
        }, { rootMargin: "0px 0px -10% 0px", threshold: 0.05 });
        tiles.forEach((t) => io.observe(t));
      }
    }

    /* ---------- 상세 모달 ---------- */
    const detail = document.getElementById("pg-detail");
    const dImg = document.getElementById("pg-detail-img");
    const dTitle = document.getElementById("pg-detail-title");
    const dCrumb = document.getElementById("pg-detail-crumb");
    const dClient = document.getElementById("pg-detail-client");
    const dYear = document.getElementById("pg-detail-year");
    const dRole = document.getElementById("pg-detail-role");
    const dBrief = document.getElementById("pg-detail-brief");
    const dClose = document.getElementById("pg-detail-close");

    function openDetail(i) {
      const p = data[i];
      if (!p || !detail) return;
      dImg.src = p.image || p.thumbnail; dImg.alt = p.title || "Playground item";
      dTitle.textContent = p.title || "";
      dCrumb.textContent = "№" + p.num;
      dClient.textContent = p.client || "";
      dYear.textContent = p.year || "";
      dRole.textContent = p.role || "";
      dBrief.textContent = p.brief || "";
      detail.dataset.open = "true";
      detail.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      detail.scrollTop = 0;
    }
    function closeDetail() {
      if (!detail) return;
      detail.dataset.open = "false";
      detail.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }
    dClose && dClose.addEventListener("click", closeDetail);
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && detail && detail.dataset.open === "true") closeDetail(); });

    /* ---------- Publications 아코디언 ---------- */
    const items = document.querySelectorAll("#publications .pub-item");
    items.forEach((item) => {
      const toggle = item.querySelector(".pub-toggle");
      toggle.addEventListener("click", () => {
        const willOpen = item.dataset.open !== "true";
        items.forEach((o) => {
          if (o !== item) {
            o.dataset.open = "false";
            const t = o.querySelector(".pub-toggle");
            t.setAttribute("aria-expanded", "false"); t.textContent = "+";
          }
        });
        item.dataset.open = String(willOpen);
        toggle.setAttribute("aria-expanded", String(willOpen));
        toggle.textContent = willOpen ? "−" : "+";
      });
    });
  })();
</script>
{% endraw %}

{% comment %} ===== Liquid Glass 효과 (VFX-JS) — {% endcomment %}
{% comment %} raw 로 감싸 Liquid 파싱 방지 ===== {% endcomment %}
{% raw %}
<script type="module">
  // Liquid glass post-effect — original by Amagi (MIT), https://codepen.io/fand/pen/azmPjqd
  // VFX-JS — https://amagi.dev/vfx-js/

  const PARAMS = {
    sphereR: 0.12,
    bubbleCount: 8,
    bubbleRadiusMin: 0.03,
    bubbleRadiusMax: 0.07,
    bubbleSpeed: 0.7,
    mouseSmoothing: 0.05,
  };

  // ── 효과를 켤지 판단하는 가드 (성능/접근성/호환성) ──
  const prefersReduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const desktopGlass = matchMedia("(min-width: 1200px)");
  function hasWebGL2() {
    try { return !!document.createElement("canvas").getContext("webgl2"); }
    catch (e) { return false; }
  }
  const enableGlass = !prefersReduced && desktopGlass.matches && hasWebGL2();

  // 유리를 지원하지 않으면 유리 on/off 버튼을 숨김
  if (!enableGlass) {
    const gb = document.getElementById("folio-glass-toggle");
    if (gb) gb.style.display = "none";
  }

  const postEffectShader = `
    precision highp float;
    uniform sampler2D src;
    uniform vec2 resolution;
    uniform vec2 offset;
    uniform vec2 mouse;
    uniform vec2 lag;
    uniform float time;
    uniform float clickTime;
    uniform int clickCount;
    out vec4 outColor;

    const float SPHERE_R = ${PARAMS.sphereR.toFixed(4)};

    const float DISP = 0.025;
    const int   DISP_STEPS = 12;
    const float DISP_LO = 0.0;
    const float DISP_HI = 1.0;

    const float SCATTER = 0.03;

    const int N_BUBBLES = ${PARAMS.bubbleCount};
    const float BUBBLE_SMOOTH = 0.025;
    uniform float bubbleData[${PARAMS.bubbleCount * 4}];

    const vec3 ABSORB = vec3(2.0, 1.2, 1.0) * 3.;

    float smin(float a, float b, float k) {
      float h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
      return mix(b, a, h) - k * h * (1.0 - h);
    }

    vec2 hash22(vec2 p) {
      vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
      p3 += dot(p3, p3.yzx + 33.33);
      return fract((p3.xx + p3.yz) * p3.zy) * 2.0 - 1.0;
    }

    mat2 rot(float t) {
      float c = cos(t), s = sin(t);
      return mat2(c, -s, s, c);
    }

    float sdSphere(vec3 p, float r) { return length(p) - r; }

    float sdBox(vec3 p, vec3 b, float r) {
      vec3 q = abs(p) - b + r;
      return length(max(q,0.0)) + min(max(q.x,max(q.y,q.z)),0.0) - r;
    }

    float sdRing(vec3 p, vec2 r) {
      float s = length(p.xy) - r.x;
      return length(vec2(s, p.z)) - r.y;
    }

    float map(vec3 p, vec3 c) {
      vec3 q = p - c;

      float tt = clickTime * 5.0;
      float bounce = exp(-tt) * sin(tt) * 5. + (1. - exp(-tt));
      float s = bounce * 0.5 + 0.5;
      q /= s;

      q.xz *= rot(exp(-clickTime*3.0) * 8.);

      vec3 sp = q;
      sp.y += sin(sp.z * 29. + time * 6.5) * 0.01;
      sp.z += sin(sp.x * 23. + sp.y * 11. + time * 7.) * 0.01;
      sp.xy *= rot(time*1.3);
      sp.xz *= rot(time*1.1);

      float d ;
      int objType = clickCount % 3;
      if (objType == 0) {
        d = sdSphere(sp, SPHERE_R);
      } else if (objType == 1) {
        d = sdBox(sp, vec3(SPHERE_R*0.8), 0.01);
      } else {
        d = sdRing(sp, vec2(SPHERE_R*1.1, 0.015));
      }

      for (int i = 0; i < N_BUBBLES; i++) {
        int b = i * 4;
        vec3 bPos = vec3(bubbleData[b], bubbleData[b+1], bubbleData[b+2]);
        float r = bubbleData[b+3];
        d = smin(d, sdSphere(q - bPos, max(r, 0.001)), BUBBLE_SMOOTH);
      }

      return d * s;
    }

    vec3 calcNormal(vec3 p, vec3 c) {
      vec2 e = vec2(0.001, 0.0);
      return normalize(vec3(
        map(p + e.xyy, c) - map(p - e.xyy, c),
        map(p + e.yxy, c) - map(p - e.yxy, c),
        map(p + e.yyx, c) - map(p - e.yyx, c)
      ));
    }

    vec3 spectrum(float x) {
      return clamp(vec3(
        1.5 - abs(4.0 * x - 1.0),
        1.5 - abs(4.0 * x - 2.0),
        1.5 - abs(4.0 * x - 3.0)
      ), 0.0, 1.0);
    }

    vec4 getSrc(vec2 uv) {
      vec4 c = texture(src, uv);
      return mix(vec4(1), c, c.a);
    }

    void main() {
      vec2 uv = (gl_FragCoord.xy - offset) / resolution;
      float aspect = resolution.y / resolution.x;

      vec2 p = (uv - 0.5) * vec2(1.0, aspect);
      vec2 mp = ((mouse + lag) / resolution - 0.5) * vec2(1.0, aspect);

      vec3 ro = vec3(0.0, 0.0, -2.0);
      float focal = 2.0;
      vec3 rd = normalize(vec3(p, focal));

      vec3 c = vec3(mp, 0.0);

      vec3 firstN = vec3(0.0);
      vec3 lastN = vec3(0.0);
      int hitCount = 0;

      float thickness = 0.0;
      float tEntry = 0.0;
      float t = 0.0;
      bool inside = false;
      for (int i = 0; i < 50; i++) {
        if (t > 10.0) break;

        vec3 pos = ro + rd * t;
        float d = map(pos, c);

        float step = inside ? -d : d;
        if (step < 3e-4) {
          vec3 n = calcNormal(pos, c);
          if (hitCount == 0) firstN = n;
          lastN = n;
          if (!inside) {
            tEntry = t;
          } else {
            thickness += t - tEntry;
          }

          hitCount++;
          if (hitCount >= 4) { break; }

          inside = !inside;
          t += 0.01;
        } else {
          t += step;
        }
      }

      if (hitCount > 0) {
        vec2 baseDisp = -(firstN.xy + lastN.xy) * 0.5 * DISP;

        float NdotR = max(dot(firstN, -rd), 0.0);
        float scatter = pow((1.0 - NdotR), 2.0) * SCATTER;

        vec3 acc = vec3(0.0);
        vec3 wsum = vec3(0.0);
        for (int i = 0; i < DISP_STEPS; i++) {
          float wl = float(i) / float(DISP_STEPS - 1);
          float k = mix(DISP_LO, DISP_HI, wl) * (1.3 + float(hitCount) * 0.2);
          vec2 h = hash22(uv * 1000.0 + float(i) * 7.13 + time) * scatter;
          vec3 w = spectrum(wl);
          acc += getSrc(uv + baseDisp * k + h).rgb * w;
          wsum += w;
        }
        vec3 col = acc / wsum * 0.99;
        col -= float(hitCount) * 0.05;

        col += 0.1;

        float fres = pow(1.0 - NdotR, 5.0);
        col *= 1. + fres;

        float f2 = 1. - pow(NdotR, 3.0);
        col *= mix(vec3(1), exp(-ABSORB * thickness), f2);
        col *= 1. + f2;

        vec3 ld = normalize(vec3(0.5, 0.9, -0.3));
        float spec = pow(max(dot(reflect(-ld, firstN), -rd), 0.0), 200.0);
        col += spec * 30.;

        ld = normalize(vec3(-0.9, 0.4, -0.3));
        spec = pow(max(dot(reflect(-ld, firstN), -rd), 0.0), 300.0);
        col += spec * 3.;

        ld = normalize(vec3(-0.1, -0.9, -0.1));
        spec = pow(max(dot(reflect(-ld, firstN), -rd), 0.0), 30.0);
        col += spec * 0.5;

        col = min(col, 1.);
        col = 1. - abs(col + fres * .5 - 1.);

        outColor = vec4(col, 1.0);
      } else {
        outColor = getSrc(uv);
      }
    }
  `;

  // 유리 효과를 다크모드에서도 유지합니다. (라이트에서만 쓰고 싶다면 false 로 바꾸세요)
  const GLASS_IN_DARK = true;
  const isDark = () => document.documentElement.getAttribute("data-theme") === "dark";

  if (enableGlass) {
    window.addEventListener("load", async () => {
      let VFX;
      try {
        ({ VFX } = await import("https://esm.sh/@vfx-js/core@0.11.1"));
      } catch (e) {
        console.warn("[folio] VFX-JS 로드 실패, 일반 화면으로 표시합니다.", e);
        return;
      }

      // 큰 필기체 폰트가 텍스처에 담기도록 폰트 로딩을 기다림
      if (document.fonts && document.fonts.ready) {
        try { await document.fonts.ready; } catch (e) {}
      }

      const app = document.getElementById("folio-app");
      if (!app) return;

      const N = PARAMS.bubbleCount;
      const fract = (x) => x - Math.floor(x);
      const rot2d = (x, y, t) => {
        const c = Math.cos(t), s = Math.sin(t);
        return [x * c - y * s, x * s + y * c];
      };

      const p0 = { x: 0, y: 0 };
      const p1 = { x: 0, y: 0 };
      const p2 = { x: 0, y: 0 };
      let hasMouse = false;
      let centerBlend = 1.0;
      window.addEventListener("pointermove", (e) => {
        p0.x = e.clientX;
        p0.y = window.innerHeight - e.clientY;
        hasMouse = true;
      });

      let lastClickTime = performance.now() / 1000;
      let clickCount = 0;
      window.addEventListener("pointerdown", () => {
        lastClickTime = performance.now() / 1000;
        clickCount++;
      });

      const bubbles = new Float32Array(N * 4);
      const t0 = performance.now() / 1000;

      function tick() {
        const time = performance.now() / 1000 - t0;
        const sm = PARAMS.mouseSmoothing;
        p1.x += (p0.x - p1.x) * sm;
        p1.y += (p0.y - p1.y) * sm;
        p2.x += (p1.x - p2.x) * sm;
        p2.y += (p1.y - p2.y) * sm;

        if (hasMouse) { centerBlend *= 0.95; }

        for (let i = 0; i < N; i++) {
          const life = fract(time * PARAMS.bubbleSpeed + i / N);
          const orbitR = PARAMS.sphereR * (0.3 + life * 0.8);
          const orbitAngle = time * (0.8 + fract(i * 0.618) * 0.7) + i * 1.256;

          let bx = Math.cos(orbitAngle) * orbitR;
          let by = 0;
          let bz = Math.sin(orbitAngle) * orbitR;

          [bx, by] = rot2d(bx, by, i * 2.3);
          [by, bz] = rot2d(by, bz, i * 1.8);

          by += life * 0.1;
          bx += Math.sin(time * 2.7 + i * 4.1) * 0.008 * life;
          bz += Math.cos(time * 3.1 + i * 3.7) * 0.008 * life;

          const w = window.innerWidth, h = window.innerHeight;
          bx += ((p2.x - p1.x) / w) * (h / w);
          by += (p2.y - p1.y) / h;

          const range = PARAMS.bubbleRadiusMax - PARAMS.bubbleRadiusMin;
          const maxR = PARAMS.bubbleRadiusMin + range * fract(i * 0.618);

          const j = i * 4;
          bubbles[j] = bx;
          bubbles[j + 1] = by;
          bubbles[j + 2] = bz;
          bubbles[j + 3] = maxR * Math.sin(life * Math.PI);
        }
        requestAnimationFrame(tick);
      }
      tick();

      // ── 유리 인스턴스 생성/파괴 ──
      let vfx = null;

      async function buildGlass() {
        if (vfx) return;
        const inst = new VFX({
          zIndex: 1,
          pixelRatio: Math.min((window.devicePixelRatio || 1) * 2, 3), // 슈퍼샘플링 → 텍스트 선명도 개선
          postEffect: {
            shader: postEffectShader,
            uniforms: {
              lag: () => {
                const lx = (p1.x - p0.x) * devicePixelRatio;
                const ly = (p1.y - p0.y) * devicePixelRatio;
                const cx = (window.innerWidth / 2) * devicePixelRatio * centerBlend;
                const cy = (window.innerHeight / 2) * devicePixelRatio * centerBlend;
                return [cx + lx, cy + ly];
              },
              clickTime: () => performance.now() / 1000 - lastClickTime,
              clickCount: () => clickCount,
              bubbleData: () => bubbles,
            },
          },
        });
        try {
          await inst.addHTML(app, { shader: "none" });
          inst.play();
          vfx = inst;
        } catch (e) {
          console.warn("[folio] 유리 효과 생성 실패", e);
          try { inst.destroy(); } catch (_) {}
        }
      }

      function teardownGlass() {
        if (!vfx) return;
        try { vfx.destroy(); } catch (e) {}  // 캔버스 제거 + 원본 DOM 복원
        vfx = null;
        // 혹시 원본 요소가 숨겨진 채 남지 않도록 강제 복원
        app.style.opacity = "";
        app.style.visibility = "";
      }

      // 현재 테마에 맞춰 유리 표시 여부 결정
      function applyGlassForTheme() {
        if (GLASS_IN_DARK || !isDark()) {
          buildGlass();          // 라이트: 유리 켜기 (매번 새 색으로 캡처)
        } else {
          teardownGlass();       // 다크: 유리 제거 → 순수한 색 반전만 표시(진짜 다크모드)
        }
      }

      // 유리 상태(버튼 on/off, 스크롤 위치)
      let glassEnabled = true;
      let scrolledAway = false;
      const atTop = () => (window.scrollY || document.documentElement.scrollTop || 0) <= 4;

      // Liquid Glass는 데스크톱에서만 허용합니다. 개발자 도구로 폭을
      // 모바일/태블릿 크기로 줄이는 경우에도 즉시 효과를 제거합니다.
      desktopGlass.addEventListener("change", (event) => {
        const gb = document.getElementById("folio-glass-toggle");
        if (!event.matches) {
          glassEnabled = false;
          teardownGlass();
          if (gb) gb.style.display = "none";
          return;
        }

        glassEnabled = true;
        if (gb) gb.style.removeProperty("display");
        if (atTop() && (GLASS_IN_DARK || !isDark())) buildGlass();
      });

      applyGlassForTheme();

      // 낮/밤 전환 시
      let rebuildTimer = null;
      window.addEventListener("folio:themechange", () => {
        // 유리가 꺼져 있거나(버튼), 스크롤 상태거나, 다크-끄기 설정이면 표시 안 함
        const shouldShow = glassEnabled && atTop() && (GLASS_IN_DARK || !isDark());
        if (!shouldShow) { teardownGlass(); return; }
        if (!vfx) { buildGlass(); return; }           // 유리가 없던 상태면 새로 생성

        // 색이 즉시 확정되므로(전환 애니메이션 제거됨) 다음 프레임에 제자리 재캡처
        requestAnimationFrame(() => {
          try {
            vfx.update(app); // 캔버스를 유지한 채 새 색으로 텍스처만 갱신
          } catch (e) {
            // 드물게 update 미지원 시 폴백: 재생성
            teardownGlass();
            clearTimeout(rebuildTimer);
            rebuildTimer = setTimeout(buildGlass, 60);
          }
        });
      });

      // 소셜 아이콘 호버 시: 유리 텍스처를 갱신해 '색 진해짐'이 유리 너머로도 보이게
      const socials = app.querySelector(".folio-socials");
      if (socials) {
        const reglass = () => {
          try { vfx && vfx.update(app); } catch (e) {}
          // 0.2s 호버 트랜지션이 끝난 최종 상태도 캡처
          setTimeout(() => { try { vfx && vfx.update(app); } catch (e) {} }, 240);
        };
        socials.addEventListener("pointerover", reglass);
        socials.addEventListener("pointerout", reglass);
        socials.addEventListener("focusin", reglass);
        socials.addEventListener("focusout", reglass);
      }

      // 유리 on/off 버튼 + 스크롤 시 캔버스 제거(흰 화면 방지) / 최상단 복원
      window.addEventListener("folio:glasstoggle", () => {
        glassEnabled = !glassEnabled;
        const gb = document.getElementById("folio-glass-toggle");
        if (gb) gb.dataset.off = String(!glassEnabled);
        if (!glassEnabled) {
          teardownGlass();
        } else if (atTop() && (GLASS_IN_DARK || !isDark())) {
          buildGlass();
          scrolledAway = false;
        } else {
          scrolledAway = true; // 스크롤 상태면 최상단 복귀 때 생성
        }
      });

      // 유리는 첫 화면 전용 효과 → 스크롤하면 캔버스를 제거해 아래 섹션을 덮지 않게
      window.addEventListener("scroll", () => {
        if (!glassEnabled) return;
        const y = window.scrollY || document.documentElement.scrollTop || 0;
        if (y > 40 && !scrolledAway) {
          scrolledAway = true;
          teardownGlass();
        } else if (y <= 4 && scrolledAway) {
          scrolledAway = false;
          if (GLASS_IN_DARK || !isDark()) buildGlass();
        }
      }, { passive: true });
    });
  }
</script>
