<style>
  /* 이 <style> 블록은 home 레이아웃(=홈 페이지)에서만 출력되므로,
     아래 규칙들은 :has() 없이도 홈에만 적용됩니다. (구형 브라우저 호환) */

  /* al-folio 기본 네비바 / 푸터 / 헤더 숨기기 */
  #navbar,
  footer,
  .post .post-header { display: none !important; }

  /* 스크롤 완전 차단 + 정확히 한 화면 */
  html,
  body {
    height: 100%;
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
  }
  .container.mt-5,
  .container[role="main"] {
    margin: 0 !important;
    padding: 0 !important;
    max-width: 100% !important;
    height: 100dvh;
    overflow: hidden;
  }

  .folio-home {
    /* ── 라이트(기본) 색상 ── */
    --fg: rgb(50, 50, 50);
    --muted: #9a9a96;
    --line: #cfcfcb;
    --bg: #ececea;
    --cap: #4a4a48;
    background: var(--bg);
    color: var(--fg);
    font-family: "Google Sans", "Inter", system-ui, -apple-system, sans-serif;
    font-optical-sizing: auto;
    font-variation-settings: "GRAD" 0;
    position: relative;    /* 토글 버튼의 기준 */
    height: 100vh;         /* dvh 미지원 브라우저 폴백 */
    height: 100dvh;        /* 모바일 주소창 변화까지 반영한 실제 화면 높이 */
    overflow: hidden;      /* 넘치는 부분은 잘라 스크롤 방지 */
    padding: clamp(1rem, 2.5vh, 2.2rem) 24px clamp(1rem, 2.5vh, 2.4rem);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
  }

  /* al-folio는 테마 전환 시 <html>에 .transition 을 붙여 모든 요소의 색/크기를
     서서히 바꿉니다(transition: all). 이게 유리 캔버스 크기까지 애니메이션시켜
     '작아졌다 커지는' 깜빡임을 만들고, 중간 회색 프레임이 캡처되기도 합니다.
     → 홈에서는 전환 애니메이션을 완전히 꺼서 색/크기가 즉시 확정되게 함.
     (이 스타일은 홈에서만 출력되므로 다른 페이지엔 영향 없음) */
  html.transition,
  html.transition *,
  html.transition *::before,
  html.transition *::after {
    transition: none !important;
  }

  /* ── 다크 색상: 배경 완전 검정 ── */
  [data-theme="dark"] .folio-home {
    --fg: #f4f4f4;
    --muted: #5c5c5c;
    --line: #262626;
    --bg: #000000;
    --cap: #8a8a8a;
  }

  [data-theme="dark"] .folio-illus {
    filter: invert(1);
  }

  .folio-top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;   /* 좌: 오픈 문구 / 중앙: 브랜드 / 우: 소셜 */
    align-items: center;
    gap: 1rem;
    font-size: 0.8rem;
    line-height: 1.35;
  }
  .folio-top .brand {
    justify-self: start;                   /* 왼쪽으로 이동 */
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 415;                      /* 더 얇게 */
    font-size: 1.4rem;
    letter-spacing: 0;                     /* 자간 살짝 줄임 */
    white-space: nowrap;
  }
  .folio-top .brand span {
    color: var(--fg);  /* 전역 span color 덮어쓰기 + 다크모드 전환 */
  }
  .folio-top .brand-logo { width: 1.5rem; height: 1.5rem; object-fit: contain; flex-shrink: 0; }
  .folio-top .brand sup { font-size: 0.55em; }
  /* 가운데 단독 로고 (icon.svg) */
  .folio-top .folio-mark { justify-self: center; width: 1.6rem; height: 1.6rem; flex-shrink: 0; color: var(--fg); }

  /* 우상단 소셜 아이콘 */
  .folio-socials {
    justify-self: end;
    display: flex;
    gap: 0.55rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .folio-socials a {
    width: 2.4rem;
    height: 2.4rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--fg);
    opacity: 0.55;                 /* 기본: 살짝 연하게 */
    transition: opacity 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }
  .folio-socials a:hover,
  .folio-socials a:focus-visible {
    opacity: 1;                    /* 호버: 색이 살짝 진해짐 */
    background-color: color-mix(in srgb, var(--fg) 7%, transparent);
    border-color: color-mix(in srgb, var(--fg) 32%, var(--line));
  }
  .folio-socials svg { height: 1.15rem; width: auto; display: block; }

  .folio-hero {
    text-align: center;
    line-height: 0.82;
    margin: clamp(0.5rem, 2vh, 2rem) 0;
    flex: 1 1 auto;
    min-height: 0;         /* flex 자식이 화면 높이에 맞게 줄어들 수 있도록 */
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.2em;
  }
  /* min(가로폭, 화면높이) 로 상한을 걸어 낮은 화면에서도 글자가 넘치지 않게 */
  .folio-hero .script {
    font-weight: 500;                 /* Google Sans (folio-home에서 상속), 얇게 */
    letter-spacing: -0.02em;
    font-size: clamp(2.75rem, min(16vw, 20vh), 15rem);
    color: var(--fg);                 /* 전역 span color 덮어쓰기 + 다크모드 전환 */
  }
  .folio-hero .bold {
    font-weight: 700;
    letter-spacing: -0.04em;
    font-size: clamp(2.75rem, min(16vw, 20vh), 15rem);
    color: var(--fg);
  }
  .folio-hero sup {
    font-size: clamp(1rem, 2.5vw, 2.2rem);
    font-weight: 400;
    vertical-align: top;
    align-self: flex-start;
    margin-top: 0.4em;
  }

  .folio-nav {
    display: flex;
    justify-content: space-between;   /* 01–05 + ©를 전체 폭에 고르게 */
    gap: 1rem;
    flex-wrap: wrap;
    align-items: flex-end;
    border-top: 1px solid var(--line);
    padding-top: 0.9rem;
    font-size: 0.9rem;
  }
  .folio-nav a { color: var(--fg); text-decoration: none; transition: opacity 0.2s; }
  .folio-nav a:hover { opacity: 0.55; }
  .folio-nav .num { color: var(--muted); font-size: 0.72rem; display: block; }
  .folio-nav .copy { color: var(--muted); }

  .folio-foot {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(1rem, 4vw, 3rem);
    margin-top: clamp(2rem, 6vw, 5rem);
  }
  .folio-foot .blurb {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.3px;
    line-height: 1.55;
    text-transform: uppercase;
    text-align: center;
    max-width: 26ch;
    margin: 0 auto;
  }
  .folio-illus { width: clamp(80px, 12vh, 160px); height: auto; color: var(--fg); }
  .folio-caption { text-align: center; font-size: 0.82rem; color: var(--cap); margin-top: clamp(0.5rem, 1.5vh, 1.2rem); }

  /* ── 낮/밤 전환 토글 ── */
  .folio-theme {
    position: absolute;
    bottom: clamp(0.9rem, 3vh, 1.6rem);
    right: clamp(1.2rem, 4vw, 3.2rem);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--fg);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 5;
    transition: opacity 0.2s ease, border-color 0.3s ease, color 0.3s ease;
  }
  .folio-theme:hover { opacity: 0.6; }
  .folio-theme svg { width: 18px; height: 18px; }
  .folio-theme .icon-sun { display: none; }
  [data-theme="dark"] .folio-theme .icon-sun { display: block; }
  [data-theme="dark"] .folio-theme .icon-moon { display: none; }

  /* 화면이 낮을 때: 하단 블록 전체를 눌러 담기 */
  @media (max-height: 760px) {
    .folio-foot { margin-top: clamp(0.8rem, 2.5vh, 3rem); }
    .folio-illus { width: clamp(100px, 14vh, 180px); }
    .folio-foot .blurb { font-size: 0.72rem; }
  }

  @media (max-width: 720px) {
    .folio-top { grid-template-columns: 1fr; gap: 0.6rem; }
    .folio-top .brand { justify-self: start; }
    .folio-top .folio-mark { justify-self: start; }
    .folio-socials { justify-self: start; }
    .folio-foot { grid-template-columns: 1fr; gap: 0.8rem; }
    .folio-foot .folio-illus { order: -1; margin: 0 auto; width: clamp(96px, 12vh, 150px); }
    .folio-foot .blurb { font-size: 0.7rem; max-width: 34ch; }
  }
</style>

