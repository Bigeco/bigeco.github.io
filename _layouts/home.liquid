---
layout: default
---
{% comment %}
  ===== Folio home + Liquid Glass (VFX-JS) =====
  Liquid glass post-effect by Amagi (MIT) — https://codepen.io/fand/pen/azmPjqd
  VFX-JS — https://amagi.dev/vfx-js/
{% endcomment %}

<link
  href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
  rel="stylesheet"
>

<style>
  /* 자체 호스팅 Google Sans (assets/fonts/에 woff2 배치 필요)
     — 유리 캡처(dom-to-canvas)에서도 웹폰트가 누락되지 않도록 same-origin 으로 제공 */
  @font-face {
    font-family: "Google Sans";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("{{ '/assets/fonts/GoogleSans-Regular.woff2' | relative_url }}") format("woff2");
  }
  @font-face {
    font-family: "Google Sans";
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url("{{ '/assets/fonts/GoogleSans-Medium.woff2' | relative_url }}") format("woff2");
  }
  @font-face {
    font-family: "Google Sans";
    font-style: normal;
    font-weight: 600 700;
    font-display: swap;
    src: url("{{ '/assets/fonts/GoogleSans-Bold.woff2' | relative_url }}") format("woff2");
  }

  /* 이 &lt;style&gt; 블록은 home 레이아웃(=홈 페이지)에서만 출력되므로,
     아래 규칙들은 :has() 없이도 홈에만 적용됩니다. (구형 브라우저 호환) */

  /* al-folio 기본 네비바 / 푸터 / 헤더 / 스크롤 진행바 숨기기 */
  #navbar,
  footer,
  #progress,
  .progress-container,
  #progressbar,
  #myBar,
  .post .post-header { display: none !important; }

  /* 스크롤 허용(앵커로 섹션 이동) + al-folio 래퍼 여백 제거 */
  html { scroll-behavior: smooth; }
  html, body {
    margin: 0 !important;
    padding: 0 !important;
    overflow-x: hidden !important;
  }
  .container.mt-5,
  .container[role="main"] {
    margin: 0 !important;
    padding: 0 !important;
    max-width: 100% !important;
  }

  .folio-home {
    /* ── 라이트(기본) 색상 ── */
    --fg: rgb(50, 50, 50);
    --muted: #9a9a96;
    --line: #cfcfcb;
    --bg: oklch(96% 0.005 90);
    --cap: #4a4a48;
    background: var(--bg);
    color: var(--fg);
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-optical-sizing: auto;
    font-variation-settings: "GRAD" 0;
    position: relative;    /* 토글 버튼의 기준 */
    min-height: 100vh;     /* 히어로는 첫 화면을 채움(dvh 폴백) */
    min-height: 100dvh;
    overflow: hidden;      /* 히어로 내부만 잘림(페이지 전체는 스크롤) */
    padding: clamp(1rem, 2.5vh, 2.2rem) 24px clamp(1rem, 2.5vh, 2.4rem);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
  }

  /* al-folio는 테마 전환 시 <html>에 .transition 을 붙여 모든 요소의 색/크기를
     서서히 바꿉니다(transition: all). 이게 유리 캔버스 크기까지 애니메이션시켜
     '작아졌다 커지는' 깜빡임을 만들고, 중간 회색 프레임이 캡처되기도 합니다.
     → 홈에서는 전환 애니메이션을 완전히 꺼서 색/크기가 즉시 확정되게 함.
     (이 스타일은 홈에서만 출력되므로 다른 페이지엔 영향 없음) */
  html.transition,
  html.transition *,
  html.transition *::before,
  html.transition *::after {
    transition: none !important;
  }

  /* ── 다크 색상: 배경 완전 검정 ── */
  [data-theme="dark"] .folio-home {
    --fg: #f4f4f4;
    --muted: #5c5c5c;
    --line: #262626;
    --bg: #000000;
    --cap: #8a8a8a;
  }

  [data-theme="dark"] .folio-illus {
    filter: invert(1);
  }

  .folio-top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;   /* 좌: 오픈 문구 / 중앙: 브랜드 / 우: 소셜 */
    align-items: center;
    gap: 1rem;
    font-size: 0.8rem;
    line-height: 1.35;
  }
  .folio-top .brand {
    justify-self: start;                   /* 왼쪽으로 이동 */
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 415;                      /* 더 얇게 */
    font-size: 1.4rem;
    letter-spacing: 0;                     /* 자간 살짝 줄임 */
    white-space: nowrap;
  }
  .folio-top .brand span {
    color: var(--fg);  /* 전역 span color 덮어쓰기 + 다크모드 전환 */
  }
  .folio-top .brand-logo { width: 1.5rem; height: 1.5rem; object-fit: contain; flex-shrink: 0; }
  .folio-top .brand sup { font-size: 0.55em; }
  /* 가운데 단독 로고 (icon.svg) */
  .folio-top .folio-mark { justify-self: center; width: 1.6rem; height: 1.6rem; flex-shrink: 0; color: var(--fg); }

  /* 우상단 소셜 아이콘 */
  .folio-socials {
    justify-self: end;
    display: flex;
    gap: 0.55rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .folio-socials a {
    width: 2.4rem;
    height: 2.4rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--fg);
    opacity: 0.55;                 /* 기본: 살짝 연하게 */
    transition: opacity 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }
  .folio-socials a:hover,
  .folio-socials a:focus-visible {
    opacity: 1;                    /* 호버: 색이 살짝 진해짐 */
    background-color: color-mix(in srgb, var(--fg) 7%, transparent);
    border-color: color-mix(in srgb, var(--fg) 32%, var(--line));
  }
  .folio-socials svg { height: 1.15rem; width: auto; display: block; }

  .folio-menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--fg);
    cursor: pointer;
  }
  .folio-menu-toggle__line {
    display: block;
    position: absolute;
    top: 50%;
    left: 50%;
    width: 35px;
    height: 1.5px;
    background: currentColor;
    transform-origin: center;
    transition: width 0.2s ease, transform 0.2s ease;
  }
  .folio-menu-toggle__line:first-child { transform: translate(-50%, -50%) translateY(-4px); }
  .folio-menu-toggle__line:last-child { transform: translate(-50%, -50%) translateY(4px); }
  .folio-header[data-menu-open="true"] .folio-menu-toggle__line {
    width: 29.3449px;
  }
  .folio-header[data-menu-open="true"] .folio-menu-toggle__line:first-child { transform: translate(-50%, -50%) rotate(45deg); }
  .folio-header[data-menu-open="true"] .folio-menu-toggle__line:last-child { transform: translate(-50%, -50%) rotate(-45deg); }

  .folio-menu-panel { display: none; }

  .folio-hero {
    text-align: center;
    line-height: 0.82;
    margin: clamp(0.5rem, 2vh, 2rem) 0;
    flex: 1 1 auto;
    min-height: 0;         /* flex 자식이 화면 높이에 맞게 줄어들 수 있도록 */
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .folio-hero .hero-name {
    /* 단어 사이 공백도 이 크기로 렌더 → 유리 on/off 상관없이 동일한 여백 */
    font-size: clamp(2.75rem, min(16vw, 20vh), 15rem);
  }
  .folio-hero .script {
    font-weight: 500;                 /* 시스템 폰트 (folio-home에서 상속), 얇게 */
    letter-spacing: -0.02em;
    font-size: clamp(2.75rem, min(16vw, 20vh), 15rem);
    color: var(--fg);                 /* 전역 span color 덮어쓰기 + 다크모드 전환 */
  }
  .folio-hero .bold {
    font-weight: 700;
    letter-spacing: -0.04em;
    font-size: clamp(2.75rem, min(16vw, 20vh), 15rem);
    color: var(--fg);
  }
  .folio-hero sup {
    font-size: clamp(1rem, 2.5vw, 2.2rem);
    font-weight: 400;
    vertical-align: top;
    align-self: flex-start;
    margin-top: 0.4em;
  }

  .folio-nav {
    display: flex;
    justify-content: space-between;   /* 01–05 + ©를 전체 폭에 고르게 */
    gap: 1rem;
    flex-wrap: wrap;
    align-items: flex-end;
    border-top: 1px solid var(--line);
    padding-top: 0.9rem;
    font-size: 0.9rem;
  }
  .folio-nav a { color: var(--fg); text-decoration: none; transition: opacity 0.2s; }
  .folio-nav a:hover { opacity: 0.55; }
  .folio-nav .num { color: var(--muted); font-size: 0.72rem; display: block; }
  .folio-nav .copy { color: var(--muted); }

  .folio-foot {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(1rem, 4vw, 3rem);
    margin-top: clamp(2rem, 6vw, 5rem);
  }
  .folio-foot .blurb {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.3px;
    line-height: 1.55;
    text-transform: uppercase;
    text-align: center;
    max-width: 26ch;
    margin: 0 auto;
  }
  .folio-illus { width: clamp(80px, 12vh, 160px); height: auto; color: var(--fg); }
  .folio-caption { text-align: center; font-size: 0.82rem; color: var(--cap); margin-top: clamp(0.5rem, 1.5vh, 1.2rem); }

  /* ── 낮/밤 전환 토글 ── */
  .folio-theme {
    position: fixed;                 /* 스크롤해도 화면에 고정 */
    bottom: 1.4rem;
    right: 1.4rem;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.12);
    background: #ffffff;             /* 어떤 배경 위에서도 보이도록 자체 배경 */
    color: #171717;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.1);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 9999;
    transition: background-color 0.3s ease, color 0.3s ease, box-shadow 0.3s ease, transform 0.15s ease;
  }
  [data-theme="dark"] .folio-theme {
    background: #1a1a1a;
    color: #f4f4f4;
    border-color: rgba(255, 255, 255, 0.16);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.28);
  }
  .folio-theme:hover { transform: translateY(-1px); }
  .folio-theme:active { transform: translateY(0); }
  .folio-theme svg { width: 18px; height: 18px; }
  .folio-theme .icon-sun { display: none; }
  [data-theme="dark"] .folio-theme .icon-sun { display: block; }
  [data-theme="dark"] .folio-theme .icon-moon { display: none; }

  /* ── 유리 on/off 버튼 (낮밤 버튼 위) ── */
  .folio-glass {
    position: fixed;
    bottom: calc(1.4rem + 52px);
    right: 1.4rem;
    width: 44px; height: 44px; border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.12);
    background: #ffffff; color: #171717;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.1);
    display: inline-flex; align-items: center; justify-content: center;
    cursor: pointer; z-index: 9999;
    transition: background-color 0.3s ease, color 0.3s ease, transform 0.15s ease, opacity 0.2s ease;
  }
  [data-theme="dark"] .folio-glass { background: #1a1a1a; color: #f4f4f4; border-color: rgba(255,255,255,0.16); box-shadow: 0 2px 12px rgba(0,0,0,0.28); }
  .folio-glass:hover { transform: translateY(-1px); }
  .folio-glass svg { width: 18px; height: 18px; }
  .folio-glass .folio-glass__off { position: absolute; width: 26px; height: 1.5px; background: currentColor; transform: rotate(-45deg); opacity: 0; transition: opacity 0.2s; }
  .folio-glass[data-off="true"] { opacity: 0.55; }
  .folio-glass[data-off="true"] .folio-glass__off { opacity: 1; }

  /* ── 고정 헤더 (Google Labs 스타일: blur + 스크롤 방향에 따라 숨김/표시) ── */
  .folio-header {
    position: fixed; top: 0; left: 0; right: 0; z-index: 9990;
    --fg: rgb(50,50,50); --line: #cfcfcb; --muted: #9a9a96;
    color: var(--fg);
    font-family: "Google Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
  [data-theme="dark"] .folio-header { --fg: #f4f4f4; --line: #262626; --muted: #5c5c5c; }
  .folio-header[data-hidden="true"] { transform: translateY(-115%); }
  .folio-header .folio-top {
    align-items: center;
    min-height: 3.8rem;
    padding: 0.7rem clamp(1rem, 4vw, 2.5rem);
    box-sizing: border-box;
    background: rgba(245, 244, 239, 0.72);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    backdrop-filter: saturate(180%) blur(16px);
  }
  [data-theme="dark"] .folio-header .folio-top {
    background: rgba(0, 0, 0, 0.55);
  }
  /* 헤더가 히어로 최상단을 가리지 않도록 여백 */
  .folio-home { scroll-margin-top: 4rem; }

  /* 화면이 낮을 때: 하단 블록 전체를 눌러 담기 */
  @media (max-height: 760px) {
    .folio-foot { margin-top: clamp(0.8rem, 2.5vh, 3rem); }
    .folio-illus { width: clamp(100px, 14vh, 180px); }
    .folio-foot .blurb { font-size: 0.72rem; }
  }

  @media (max-width: 1199.98px) {
    html.folio-menu-open,
    html.folio-menu-open body { overflow: hidden !important; }

    .folio-glass { display: none !important; }

    .folio-header .folio-top {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.75rem;
      position: relative;
      z-index: 2;
    }
    .folio-top .brand { justify-self: start; }
    .folio-top .folio-mark { display: none; }
    .folio-menu-toggle {
      display: block;
      position: fixed;
      top: 0.7rem;
      right: calc(clamp(1rem, 4vw, 2.5rem) + var(--folio-scrollbar-width, 0px));
      z-index: 4;
    }
    .folio-socials {
      display: flex;
      position: absolute;
      left: 50%;
      top: 50%;
      z-index: 3;
      margin: 0;
      gap: clamp(0.7rem, 2vw, 1rem);
      transform: translate(-50%, -50%);
    }
    .folio-socials a { width: 3.25rem; height: 3.25rem; }
    .folio-socials svg { height: 1.5rem; }
    html.folio-menu-open .folio-socials { display: none; }

    .folio-menu-panel {
      position: fixed;
      inset: 0;
      z-index: 1;
      min-height: 100vh;
      min-height: 100dvh;
      padding: clamp(5rem, 10vh, 7rem) clamp(1.25rem, 6vw, 3rem) clamp(1.25rem, 5vh, 3rem);
      box-sizing: border-box;
      background: var(--bg, oklch(96% 0.005 90));
      color: var(--fg);
      overflow-y: auto;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-1rem);
      transition: opacity 0.22s ease, visibility 0.22s ease, transform 0.22s ease;
    }
    [data-theme="dark"] .folio-menu-panel { --bg: #000000; }
    .folio-header[data-menu-open="true"] .folio-menu-panel {
      display: flex;
      align-items: flex-end;
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    .folio-menu-panel__nav {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0;
      width: 100%;
    }
    .folio-menu-panel__nav a {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      padding: clamp(0.8rem, 2vh, 1.25rem) 0;
      color: var(--fg);
      font-size: clamp(1.25rem, 4.5vw, 2rem);
      text-decoration: none;
    }
    .folio-menu-panel__nav a:nth-child(odd) { padding-right: clamp(1rem, 4vw, 2.5rem); }
    .folio-menu-panel__nav a:nth-child(even) {
      padding-left: clamp(1rem, 4vw, 2.5rem);
    }
    .folio-menu-panel__nav .num {
      color: var(--muted);
      font-size: 0.7rem;
    }

    .folio-home > .folio-nav {
      visibility: hidden;
      pointer-events: none;
    }
    .folio-header[data-menu-open="true"] ~ .folio-home > .folio-foot {
      visibility: hidden;
    }
  }

  @media (max-width: 720px) {
    .folio-menu-panel__nav { grid-template-columns: 1fr; }
    .folio-menu-panel__nav a:nth-child(odd),
    .folio-menu-panel__nav a:nth-child(even) {
      padding-left: 0;
      padding-right: 0;
      border-left: 0;
    }
    .folio-foot { grid-template-columns: 1fr; gap: 0.8rem; }
    .folio-foot .folio-illus { order: -1; margin: 0 auto; width: clamp(96px, 12vh, 150px); }
    .folio-foot .blurb { font-size: 0.7rem; max-width: 34ch; }
  }
  /* ============================================================
     아래는 홈에 붙는 스크롤 섹션들: #playground(모자이크), #publications(논문)
     ============================================================ */

  /* 유리 캔버스(z-index:1) 위에 올려 흰 화면 방지 */
  #playground, #publications { position: relative; z-index: 2; }

  /* Publications 테마 변수(홈과 동일, 다크 반전) */
  #publications { --fg: rgb(50,50,50); --muted: #9a9a96; --line: #cfcfcb; --bg: oklch(96% 0.005 90); --cap: #4a4a48; }
  [data-theme="dark"] #publications { --fg: #f4f4f4; --muted: #5c5c5c; --line: #262626; --bg: #000000; --cap: #8a8a8a; }

  /* ── 공통 섹션 헤더 ── */
  .sec-head {
    display: grid; grid-template-columns: 1fr; gap: 0.75rem;
    padding: 3rem 24px 1.5rem; border-bottom: 1px solid var(--sec-line, #171717);
  }
  @media (min-width: 48rem) { .sec-head { grid-template-columns: auto 1fr auto; align-items: end; } }
  .sec-head__num, .sec-head__count { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.5; }
  .sec-head__title { font-size: clamp(2rem, 6vw, 4.5rem); line-height: 0.9; letter-spacing: -0.03em; text-transform: uppercase; margin: 0; }

  /* ── PLAYGROUND: 브루탈리스트 모자이크 ── */
  #playground {
    --c-bg: oklch(96% 0.005 90); --c-fg: oklch(15% 0 0); --c-fg-soft: oklch(15% 0 0 / 0.6);
    --c-line: oklch(15% 0 0); --c-accent: oklch(88% 0.22 125);
    --ff-display: "Archivo Black", ui-sans-serif, system-ui, sans-serif;
    --ff-mono: "JetBrains Mono", ui-monospace, monospace;
    background: var(--c-bg); color: var(--c-fg);
    padding-top: clamp(2rem, 5vw, 4rem); /* Publications과의 간격 */
  }
  #playground .sec-head { --sec-line: var(--c-line); }
  #playground .sec-head__num, #playground .sec-head__count { font-family: var(--ff-mono); }
  #playground .sec-head__title { font-family: var(--ff-display); }

  /* 다크: Playground 도 검정 배경으로 통일 */
  [data-theme="dark"] #playground {
    --c-bg: #000000;
    --c-fg: #f4f4f4;
    --c-fg-soft: rgba(244, 244, 244, 0.55);
    --c-line: #262626;
  }
  [data-theme="dark"] .pg-detail { background: #000000; color: #f4f4f4; }
  [data-theme="dark"] .pg-detail__bar { background: #000000; border-bottom-color: #262626; }

  .mosaic { display: grid; grid-template-columns: repeat(var(--mosaic-cols, 6), 1fr); gap: 1px; background: var(--c-line); border-bottom: 1px solid var(--c-line); }
  .tile { position: relative; aspect-ratio: 1; background: var(--c-bg); overflow: hidden; cursor: pointer; display: none; opacity: 0; transform: translateY(12px); transition: opacity 500ms ease, transform 500ms ease; transition-delay: var(--reveal-delay, 0ms); }
  .tile[data-visible="true"] { opacity: 1; transform: none; }
  .tile:nth-child(-n + 48) { display: block; }
  @media (min-width: 48rem) { .mosaic { --mosaic-cols: 8; } .tile:nth-child(-n + 64) { display: block; } }
  @media (min-width: 64rem) { .mosaic { --mosaic-cols: 10; } .tile:nth-child(-n + 80) { display: block; } }
  @media (min-width: 80rem) { .mosaic { --mosaic-cols: 12; } .tile:nth-child(-n + 96) { display: block; } }
  .tile img { width: 100%; height: 100%; object-fit: cover; transition: transform 600ms cubic-bezier(0.2,0.8,0.2,1), filter 300ms; }
  .tile:hover img { transform: scale(1.08); filter: contrast(1.1) saturate(0.9); }
  .tile__label { position: absolute; inset: auto 0 0 0; padding: 0.5rem; font-family: var(--ff-mono); font-size: 0.625rem; text-transform: uppercase; letter-spacing: 0.05em; color: #f5f5f0; background: linear-gradient(to top, oklch(15% 0 0 / 0.85), transparent); opacity: 0; transition: opacity 200ms; display: flex; justify-content: space-between; pointer-events: none; }
  .tile:hover .tile__label { opacity: 1; }
  @media (max-width: 47.99rem) { .tile__label { display: none; } }
  @media (prefers-reduced-motion: reduce) { .tile { transition: none; opacity: 1; transform: none; } }

  /* ── PLAYGROUND 상세 모달 ── */
  .pg-detail { position: fixed; inset: 0; z-index: 9998; background: oklch(96% 0.005 90); color: oklch(15% 0 0); font-family: "Archivo", ui-sans-serif, system-ui, sans-serif; overflow-y: auto; opacity: 0; visibility: hidden; transition: opacity 300ms ease; }
  .pg-detail[data-open="true"] { opacity: 1; visibility: visible; }
  .pg-detail__bar { position: sticky; top: 0; display: flex; justify-content: space-between; align-items: center; padding: 1rem 24px; font-family: "JetBrains Mono", monospace; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid #171717; background: oklch(96% 0.005 90); }
  .pg-detail__close { font: inherit; background: none; border: 0; cursor: pointer; text-transform: uppercase; }
  .pg-detail__close:hover { color: oklch(70% 0.22 35); }
  .pg-detail__img { width: 100%; aspect-ratio: 16/9; object-fit: cover; display: block; }
  .pg-detail__body { padding: 2rem 24px 4rem; display: grid; gap: 1.5rem; max-width: 70ch; }
  .pg-detail__title { font-family: "Archivo Black"; font-size: clamp(1.8rem, 5vw, 3.5rem); line-height: 0.95; letter-spacing: -0.03em; text-transform: uppercase; margin: 0; }
  .pg-detail__meta { display: flex; flex-wrap: wrap; gap: 1.5rem; font-family: "JetBrains Mono", monospace; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.7; }
  .pg-detail__brief { font-size: 1.05rem; line-height: 1.55; margin: 0; }

  /* ── PUBLICATIONS: 홈과 동일 시스템 폰트, 논문 아코디언 ── */
  #publications {
    background: var(--bg); color: var(--fg);
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }
  #publications .sec-head { --sec-line: var(--line); }
  #publications .sec-head__num, #publications .sec-head__count {
    color: var(--fg);
    font-family: "JetBrains Mono", ui-monospace, monospace;
  }
  #publications .sec-head__title { font-family: "Archivo Black", ui-sans-serif, system-ui, sans-serif; }

  .pubs-list { list-style: none; margin: 0; padding: 0; }
  .pub-item { border-bottom: 1px solid var(--line); }
  .pub-row { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 1rem; padding: 1.4rem 24px; }
  .pub-venue { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); margin-bottom: 0.35rem; }
  .pub-title { font-size: clamp(1rem, 2.2vw, 1.4rem); font-weight: 500; line-height: 1.25; letter-spacing: -0.01em; }
  .pub-actions { display: flex; align-items: center; gap: 0.5rem; }
  .pub-btn {
    font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em;
    padding: 0.4rem 0.7rem; border: 1px solid var(--line); border-radius: 999px; color: var(--fg);
    background: transparent; text-decoration: none; white-space: nowrap;
    transition: background-color 0.2s, border-color 0.2s, opacity 0.2s;
  }
  .pub-btn:hover { background-color: color-mix(in srgb, var(--fg) 8%, transparent); border-color: color-mix(in srgb, var(--fg) 35%, var(--line)); }
  .pub-toggle {
    width: 2.2rem; height: 2.2rem; flex-shrink: 0; border: 1px solid var(--line); border-radius: 50%;
    background: transparent; color: var(--fg); cursor: pointer; font-size: 1.1rem; line-height: 1;
    display: inline-flex; align-items: center; justify-content: center;
    transition: transform 0.3s cubic-bezier(0.2,0.8,0.2,1), background-color 0.2s;
  }
  .pub-toggle:hover { background-color: color-mix(in srgb, var(--fg) 8%, transparent); }
  .pub-item[data-open="true"] .pub-toggle { transform: rotate(45deg); }
  .pub-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 400ms cubic-bezier(0.2,0.8,0.2,1); }
  .pub-item[data-open="true"] .pub-panel { grid-template-rows: 1fr; }
  .pub-panel__inner { overflow: hidden; min-height: 0; }
  .pub-abstract { margin: 0; padding: 0 24px 1.6rem; font-size: 0.95rem; line-height: 1.55; color: var(--fg); max-width: 75ch; }

  .sec-foot {
    padding: 3rem 24px; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; opacity: 0.7;
    background: var(--c-bg); color: var(--c-fg); font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    border-top: 1px solid var(--c-line);
  }

  @media (max-width: 720px) {
    .pub-row { grid-template-columns: 1fr; }
    .pub-actions { justify-content: flex-start; }
  }
</style>

