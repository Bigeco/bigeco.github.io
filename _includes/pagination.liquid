{% if paginator.total_pages > 1 %}
  <nav class="blog-pagination" aria-label="Blog page navigation">
    <ul class="blog-pagination__list">
      <li>
        {% if paginator.previous_page %}
          <a class="blog-pagination__button" href="{{ paginator.previous_page_path | relative_url }}" rel="prev" aria-label="Previous page">←</a>
        {% else %}
          <span class="blog-pagination__button" aria-disabled="true" aria-label="Previous page">←</span>
        {% endif %}
      </li>
      {% for trail in paginator.page_trail %}
        <li>
          {% if paginator.page == trail.num %}
            <span class="blog-pagination__button" aria-current="page" aria-label="Page {{ trail.num }}">{{ trail.num }}</span>
          {% else %}
            <a class="blog-pagination__button" href="{{ trail.path | relative_url | remove: 'index.html' }}" aria-label="Page {{ trail.num }}">
              {{- trail.num -}}
            </a>
          {% endif %}
        </li>
      {% endfor %}
      <li>
        {% if paginator.next_page %}
          <a class="blog-pagination__button" href="{{ paginator.next_page_path | relative_url }}" rel="next" aria-label="Next page">→</a>
        {% else %}
          <span class="blog-pagination__button" aria-disabled="true" aria-label="Next page">→</span>
        {% endif %}
      </li>
    </ul>
  </nav>
{% endif %}
